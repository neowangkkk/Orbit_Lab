# Cloudflare Pages — response headers.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# Asset filenames are NOT content-hashed, so we deliberately avoid
# "immutable" / 1-year caching: replacing a photo in place would otherwise
# stay stale in visitors' browsers for a year. One week is the compromise.
/assets/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# HTML should revalidate so content edits appear immediately.
/
  Cache-Control: public, max-age=0, must-revalidate
/*.html
  Cache-Control: public, max-age=0, must-revalidate
