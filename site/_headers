# Cloudflare — response headers.
#
# Rules are matched top to bottom and every matching rule applies; where two
# rules set the same header, the later one wins. So the catch-all goes FIRST
# and carries the safe default, and the asset rules below override it.

# Default for everything, which in practice means the HTML pages. They live at
# extensionless URLs (/people, /our-vision, ...), so a "/*.html" rule would
# never match them — putting the policy here is what closes that gap. Also
# covers robots.txt, sitemap.xml and any page added later.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Cache-Control: public, max-age=0, must-revalidate

# Media is large and rarely edited in place — cache it for a week.
/assets/img/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/assets/pdf/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/assets/video/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# CSS and JS must NOT sit in a long cache. They are small, they change with
# every layout fix, and a week-long max-age means returning visitors keep
# rendering the old stylesheet without ever asking the server — a layout fix
# then looks like it "didn't work". no-cache still revalidates against the
# ETag, so an unchanged file costs a 304, not a re-download.
/assets/css/*
  Cache-Control: no-cache
/assets/js/*
  Cache-Control: no-cache
